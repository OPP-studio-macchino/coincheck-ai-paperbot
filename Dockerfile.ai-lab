# Separate offline research image: no SDK, DB driver, exchange adapter or secrets.
FROM python:3.12-slim@sha256:b18b261e1b4974b4f321451ad5251ded85abb22c2b8b262da527dda1d031ab30
ARG APP_GIT_SHA=unversioned
LABEL org.opencontainers.image.revision="${APP_GIT_SHA}"
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /opt/lab
RUN useradd --uid 10001 --no-create-home lab \
    && mkdir -p /var/lib/ai-lab \
    && chown 10001:10001 /var/lib/ai-lab
COPY ai_lab /opt/lab/ai_lab
COPY app/__init__.py app/strategy.py /opt/lab/app/
COPY docs/ai-self-improvement/SOURCE_OF_TRUTH.md /opt/lab/docs/ai-self-improvement/SOURCE_OF_TRUTH.md
USER 10001:10001
ENTRYPOINT ["python", "-m", "ai_lab"]
CMD ["demo", "--workspace", "/var/lib/ai-lab/research", "--run-id", "offline-demo", "--max-trials", "6"]
